# TEMPLATE ONLY — DO NOT MOVE INTO .github/workflows WITHOUT REVIEW.
#
# GitHub ignores this file because it is outside .github/workflows and uses the
# .example suffix. The job is also disabled defensively. The fixture-only
# workflow at .github/workflows/studio-fixture-refresh.yml is the safe workflow
# to run today.
#
# READ-ONLY DUNE CONTRACT: Dune schedules and executes the approved queries
# independently. This workflow only imports each query's latest already-stored
# result through GET /api/v1/query/{query_id}/results (or SDK
# get_latest_result), follows result pagination, and reuses that result for all
# mapped metrics. It never executes, reruns, or refreshes a query, and it never
# enables max_age_hours or another stale-result auto-rerun behavior.
#
# Activation requires approved production query IDs, a read-only DUNE_API_KEY
# repository secret, and removal of the hard-false job guard. Do not add a
# schedule without explicit approval.

name: Import latest stored Studio Dune results (disabled template)

on:
  workflow_dispatch:
    inputs:
      confirm_read_only_import:
        description: Import reviewed stored Dune results (read only)
        required: true
        type: boolean
        default: false

permissions:
  contents: read

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  import-build-deploy-template:
    if: ${{ false && inputs.confirm_read_only_import == true }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: read
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: pyproject.toml

      - name: Install project
        run: |
          python -m pip install --upgrade pip
          python -m pip install -e '.[dev]'

      - name: Check unique query inventory
        run: python scripts/generate_studio_inventory.py --check

      - name: Fetch latest stored results, validate, and promote snapshot
        env:
          DUNE_API_KEY: ${{ secrets.DUNE_API_KEY }}
          STUDIO_ENABLE_LIVE_DUNE: "1"
        run: |
          python scripts/fetch_studio_data.py \
            --output-dir website/data/studio/generated \
            --keep-previous 1 \
            --verbose

      - name: Upload failed-refresh diagnostics
        if: ${{ failure() }}
        uses: actions/upload-artifact@v4
        with:
          name: studio-live-refresh-failure-${{ github.run_id }}
          path: |
            website/data/studio/generated/state.json
            website/data/studio/generated/attempts/
          if-no-files-found: warn
          retention-days: 7

      - name: Validate promoted snapshot
        run: |
          python scripts/fetch_studio_data.py \
            --validate-only \
            --output-dir website/data/studio/generated

      - name: Run complete tests
        run: python -m pytest -q

      - name: Build website
        run: python scripts/build_website.py

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload website artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: output/website

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
